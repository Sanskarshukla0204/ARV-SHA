# Copy to .env.local for development. In production set these in your host. Never commit real values.
# Generate the secrets with: npm run setup:secrets

# Database (Neon). Use the pooled connection string with sslmode=require.
DATABASE_URL=

# Core secrets
APP_SECRET=
PASSWORD_PEPPER=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# Public address of the site. Set to your custom domain at launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret address of the admin panel, for example studio-ab12cd34ef56ab78cd90. The panel is NOT at /admin.
ADMIN_PATH=
# Optional: comma separated IPs that may reach the admin panel.
ADMIN_IP_ALLOWLIST=

# Email (Resend). MAIL_FROM must be on a domain verified in Resend, e.g. Arvésha Clothing <orders@yourdomain.com>
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Product images (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Optional: Truecaller one-tap login
TRUECALLER_APP_KEY=
TRUECALLER_APP_NAME=

# Optional: SMS OTP for phone verification (MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Optional
GOOGLE_SITE_VERIFICATION=
DATABASE_POOL_MAX=5
